# Copy to .env after you create the KitchenWatch calendar.
# Do not commit .env.

GCP_PROJECT=truemerge
GCP_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_USE_VERTEX=1

KITCHEN_ID=demo
KITCHENWATCH_CALENDAR_ID=
WATCH_SECRET=

# Horizon Trust uses for "this item can trigger dinner"
EXPIRY_HORIZON_DAYS=2
